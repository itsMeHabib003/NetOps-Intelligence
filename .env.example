# ==============================================================================
# NetOps Intelligence Environment Configuration Template
# ==============================================================================
# IMPORTANT: Copy this file to .env and adjust variables as needed.
# NEVER commit credentials, tokens, or private keys to source control.
# ==============================================================================

# Backend Server Configuration
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
DEBUG=True

# Database Configuration (MySQL 8.0 Primary with SQLite Fallback)
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database>
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=netops_db
DB_USER=root
DB_PASSWORD=

# Fallback to local SQLite if MySQL is offline or not configured
USE_SQLITE_FALLBACK=True
SQLITE_DB_PATH=./backend/netops_local.db

# Telemetry Simulation Parameters
SIMULATION_INTERVAL_SECONDS=5
SIMULATION_DEFAULT_SCENARIO=NORMAL

# Security & CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
